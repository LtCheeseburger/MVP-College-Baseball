<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Setup</AssemblyName>
    <RootNamespace>MVPSetup</RootNamespace>
    <Product>MVP 06 NCAA Baseball Recomp Setup</Product>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\MVPWorkshop.App\Assets\MvpWorkshop.ico</ApplicationIcon>
    <!-- one file for the release zip: dotnet publish -c Release -r win-x64 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MVPWorkshop.Core\MVPWorkshop.Core.csproj" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
